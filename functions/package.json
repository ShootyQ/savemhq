{
  "name": "savemhq-functions",
  "description": "Firebase Functions for SavemHQ integrations.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "node --check index.js",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore \"node --test test/firestore-rules.test.js\"",
    "test:business": "node --test test/business-*.test.js",
    "test:business:rules": "firebase emulators:exec --project demo-business --config ../firebase.json --only firestore,storage \"node --test test/business-rules.emulator.js\"",
    "test:business:browser": "node test/business-browser.cjs",
    "test:business:images": "node test/business-images.cjs",
    "test:billing:browser": "node test/billing-browser.cjs"
  },
  "dependencies": {
    "@slack/web-api": "^7.12.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "openai": "^5.12.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.10.1",
    "playwright": "1.64.1"
  }
}
